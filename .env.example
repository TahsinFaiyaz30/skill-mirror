NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AI_MODE=live
NEXT_PUBLIC_AI_DATA_TIER=unpaid
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# AI Provider Keys (unlimited; minimum 1 key, add multiple comma-separated keys or numbered vars)
# GEMINI_API_KEY=AIza...key1,AIza...key2
# Optional extras: GEMINI_API_KEYS=... and/or GEMINI_API_KEY_1=..., GEMINI_API_KEY_2=...
GEMINI_API_KEY=
# GROQ_API_KEY=gsk_...key1,gsk_...key2
# Optional extras: GROQ_API_KEYS=... and/or GROQ_API_KEY_1=..., GROQ_API_KEY_2=...
GROQ_API_KEY=

# Gemini Models & Fallback Ladders (best model across all keys first, then step down)
MODEL_LIVE=gemini-3.8-live-extended-thinking
MODEL_LIVE_FALLBACKS=gemini-3.8-live
MODEL_LIVE_THINKING_LEVEL=low
MODEL_FLASH=gemini-4-hydrogen
MODEL_FLASH_FALLBACKS=gemini-3.8-flash,gemini-3.7-flash,gemini-3-flash-preview,gemini-3.5-flash-lite
MODEL_TRANSCRIBE=gemini-3.5-transcribe
MODEL_TRANSCRIBE_LIVE=gemini-3.5-transcribe-live
MODEL_TTS=gemini-3.8-flash-tts
MODEL_TTS_FALLBACKS=gemini-3.8-flash-lite-tts

# Groq Models & Fallback Ladders
GROQ_STRATEGIST_MODEL=openai/gpt-oss-120b
GROQ_STRATEGIST_FALLBACKS=qwen/qwen3.8-27b,openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_WHISPER_FALLBACKS=whisper-large-v3

# Security, Quotas & Admin
CERT_SIGNING_SECRET=
CRON_SECRET=
ADMIN_EMAILS=
MAX_INTERVIEWS_PER_DAY=50
MAX_COMPANY_INTERVIEWS_PER_DAY_PER_ORG=200
RECORDING_RETENTION_DAYS=30

# Email & GitHub (optional)
RESEND_API_KEY=
EMAIL_FROM=
FEATURE_GITHUB=false
GITHUB_TOKEN=
